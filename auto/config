#!/bin/sh
set -eu

# Preview images are live-only by default. Public release builds also create a
# corresponding source image with HANABIRA_BUILD_SOURCES=true.
source_mode=${HANABIRA_BUILD_SOURCES:-false}
case "$source_mode" in
    true|false) ;;
    *) echo "HANABIRA_BUILD_SOURCES must be true or false" >&2; exit 2 ;;
esac

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --system live \
    --archive-areas "main non-free-firmware" \
    --apt-recommends false \
    --bootloaders "syslinux grub-efi" \
    --debian-installer none \
    --firmware-binary true \
    --firmware-chroot true \
    --image-name hanabira-live \
    --iso-application "Hanabira OS Live" \
    --iso-publisher "Hanabira OS project" \
    --iso-volume "HANABIRA_LIVE" \
    --checksums sha256 \
    --source "$source_mode" \
    --source-images tar \
    "$@"
