#!/bin/sh
set -eu

# Until a native DRM backend exists, HDE runs nested under an existing X11 or
# Wayland display. Do not silently claim to own the physical outputs.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "Hanabira Desktop preview needs a parent X11 or Wayland display." >&2
    echo "Choose the Plasma rescue session at login for a standalone desktop." >&2
    exit 1
fi

export XDG_CURRENT_DESKTOP=Hanabira
export XDG_SESSION_DESKTOP=hanabira

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- /usr/bin/hanabira-compositor --backend nested --shell /usr/bin/hanabira-shell
fi
exec /usr/bin/hanabira-compositor --backend nested --shell /usr/bin/hanabira-shell
